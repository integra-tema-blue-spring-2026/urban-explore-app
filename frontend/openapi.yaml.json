{
  "openapi": "3.0.0",
  "info": {
    "title": "Urban Explore API",
    "version": "1.0.0",
    "description": "API for Urban Explore application"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/cities": {
      "get": {
        "summary": "Get all cities",
        "operationId": "getAllCities",
        "tags": ["Cities"],
        "responses": {
          "200": {
            "description": "List of all cities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CityDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new city",
        "operationId": "createCity",
        "tags": ["Cities"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCityDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "City created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityDto"
                }
              }
            }
          }
        }
      }
    },
    "/cities/{name}": {
      "get": {
        "summary": "Get cities by name",
        "operationId": "getCitiesByName",
        "tags": ["Cities"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of cities matching the name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CityDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cities/{id}": {
      "put": {
        "summary": "Update a city",
        "operationId": "updateCity",
        "tags": ["Cities"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCityDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "City updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a city",
        "operationId": "deleteCity",
        "tags": ["Cities"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "City deleted successfully"
          }
        }
      }
    },
    "/reviews": {
      "get": {
        "summary": "Get all reviews",
        "operationId": "getAllReviews",
        "tags": ["Reviews"],
        "responses": {
          "200": {
            "description": "List of all reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new review",
        "operationId": "createReview",
        "tags": ["Reviews"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewCreateDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Review created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDto"
                }
              }
            }
          }
        }
      }
    },
    "/reviews/{id}": {
      "put": {
        "summary": "Update a review",
        "operationId": "updateReview",
        "tags": ["Reviews"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a review",
        "operationId": "deleteReview",
        "tags": ["Reviews"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Review deleted successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "format": "int64"
          },
          "imageUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED"]
          }
        },
        "required": ["id", "name", "country", "description", "population", "imageUrl", "status"]
      },
      "CreateCityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "format": "int64"
          },
          "imageUrl": {
            "type": "string"
          }
        },
        "required": ["name", "country", "description", "population", "imageUrl"]
      },
      "UpdateCityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "population": {
            "type": "integer",
            "format": "int64"
          },
          "imageUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED"]
          }
        }
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "format": "int32"
          },
          "postedDate": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "poiId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["id", "text", "rating", "postedDate", "userId", "poiId"]
      },
      "ReviewCreateDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "poiId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["text", "rating", "userId", "poiId"]
      },
      "ReviewUpdateDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
